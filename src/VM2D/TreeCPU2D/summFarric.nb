Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GetFooText", "[", "n_", "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"\"\<#include \\\"cpuTreeInfo.h\\\"\>\"", ",", "\n", "\"\<\>\"",
         ",", "\n", "\"\<namespace VM2D\>\"", ",", "\n", "\"\<{\>\"", ","}], 
       "*)"}], "\n", 
      RowBox[{"\"\<\>\"", ",", "\n", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\"\<    inline void CpuTreeInfo::Summ\>\"", "<>", 
          RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<()\>\""}], ","}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\"\<    inline void Summ\>\"", "<>", 
        RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<()\>\""}], ",", 
       "\n", "\"\<    {\>\"", ",", 
       "\n", "\"\<        using double4 = Point4D;\>\"", ",", 
       "\n", "\"\<        using double2 = Point2D;\>\"", ",", 
       "\n", "\"\<        using int2 = std::pair<int, int>;\>\"", ",", 
       "\n", "\"\<\>\"", ",", 
       "\n", "\"\<        //\:0446\:0438\:043a\:043b \:043f\:043e \
\:0432\:043d\:0443\:0442\:0440\:0435\:043d\:043d\:0438\:043c \:0443\:0437\
\:043b\:0430\:043c \:0441\:043d\:0438\:0437\:0443 \:0432\:0432\:0435\:0440\
\:0445\>\"", ",", "\n", "\"\<\>\"", ",", "\n", "\"\<#pragma omp parallel\>\"",
        ",", "\n", "\"\<        {\>\"", ",", 
       "\n", "\"\<            int i, j, ch;\>\"", ",", "\n", "\"\<\>\"", ",", 
       "\n", "\"\<            double4 lu[2]; //bounding boxes \:0434\:0432\
\:0443\:0445 \:0434\:0435\:0442\:0435\:0439\>\"", ",", "\n", "\"\<\>\""}], 
      "\[IndentingNewLine]", "}"}], "~", "Join", "~", 
     RowBox[{"GenerateVariables", "[", "n", "]"}], "~", "Join", "~", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"\"\<            double2 cen; //\:0446\:0435\:043d\:0442\:0440 \
\:0442\:0435\:043a\:0443\:0449\:0435\:0433\:043e \:0440\:043e\:0434\:0438\
\:0442\:0435\:043b\:044c\:0441\:043a\:043e\:0433\:043e \:0443\:0437\:043b\
\:0430\>\"", ",", 
       "\n", "\"\<            double2 dr;  //\:0432\:0435\:043a\:0442\:043e\
\:0440 \:043e\:0442 \:0446\:0435\:043d\:0442\:0440\:0430 \:0440\:043e\:0434\
\:0438\:0442\:0435\:043b\:044f \:043a \:0446\:0435\:043d\:0442\:0440\:0443 \
\:0440\:0435\:0431\:0435\:043d\:043a\:0430\>\"", ",", "\n", "\"\<\>\"", ",", 
       "\n", "\"\<            int m[2]; //\:0434\:043b\:044f \:043b\:0438\
\:0441\:0442\:0430 \:044d\:0442\:043e 1, \:0434\:043b\:044f \
\:0432\:043d\:0443\:0442\:0440\:0435\:043d\:043d\:0435\:0433\:043e \:0443\
\:0437\:043b\:0430 \:044d\:0442\:043e \:0447\:0438\:0441\:043b\:043e \:043b\
\:0438\:0441\:0442\:044c\:0435\:0432 \:0432 \:043d\:0435\:043c\>\"", ",", 
       "\n", "\"\<            int cm; //\:043c\:0430\:0441\:0441\:0430 \:0442\
\:0435\:043a\:0443\:0449\:0435\:0433\:043e \:0443\:0437\:043b\:0430 = \:0441\
\:0443\:043c\:043c\:0430 \:043c\:0430\:0441\:0441 \:0434\:0432\:0443\:0445 \
\:0434\:0435\:0442\:0435\:0439\>\"", ",", 
       "\n", "\"\<            const int nnodes = 2 * (int)object.size() - \
1;\>\"", ",", 
       "\n", "\"\<            const int nbodies = (int)object.size();\>\"", ",",
        "\n", "\"\<#pragma omp for schedule(dynamic,5)\>\"", ",", 
       "\n", "\"\<            for (int k = nbodies; k < nnodes; ++k)\>\"", ",",
        "\n", "\"\<            {\>\"", ",", 
       "\n", "\"\<                //MortonTree:\>\"", ",", 
       "\n", "\"\<                // 0 1 2 ... (nb-2) x (nb+0) (nb+1) (nb+2) \
... (nb+(nb-1))\>\"", ",", 
       "\n", "\"\<                // ----------------   \
-----------------------------------\>\"", ",", 
       "\n", "\"\<                //      cells                         \
bodies\>\"", ",", "\n", "\"\<\>\"", ",", 
       "\n", "\"\<                //Martin's tree:\>\"", ",", 
       "\n", "\"\<                // 0 1 2 ... (nb-1) x x x x (nn-(nb-1)) ... \
(nn-2) (nn-1)\>\"", ",", 
       "\n", "\"\<                // ----------------          \
----------------------------\>\"", ",", 
       "\n", "\"\<                //      bodies                 sorted and \
reversed cells\>\"", ",", 
       "\n", "\"\<                //printf(\\\"k = %d\\\\n\\\", k);\>\"", ",",
        "\n", "\"\<\>\"", ",", "\n", "\"\<                j = 0;\>\"", ",", 
       "\n", "\"\<                cm = 0;\>\"", ",", "\n", "\"\<\>\"", ",", 
       "\n", "\"\<                // iterate over all cells assigned to \
thread\>\"", ",", "\n", "\"\<                while (cm == 0)\>\"", ",", 
       "\n", "\"\<                {\>\"", ",", 
       "\n", "\"\<                    j = 2;\>\"", ",", 
       "\n", "\"\<                    int srt = indexSort[(nnodes - 1) - k]; \
//\:043f\:0440\:043e\:0445\:043e\:0434 \:0441\:043d\:0438\:0437\:0443 \:0432\
\:0432\:0435\:0440\:0445 - \:0442.\:0435. \:0432 \:043e\:0431\:0440\:0430\
\:0442\:043d\:043e\:043c \:043f\:043e\:0440\:044f\:0434\:043a\:0435\>\"", ",",
        "\n", "\"\<                    int2 chdPair = child[srt];\>\"", ",", 
       "\n", "\"\<\>\"", ",", 
       "\n", "\"\<                    for (i = 0; i < 2; i++) {\>\"", ",", 
       "\n", "\"\<                        int chd = i * chdPair.second + (1 - \
i) * chdPair.first;   // i==0 => .x;  i==1 => .y\>\"", ",", "\n", "\"\<\>\"", 
       ",", "\n", "\"\<                        ch = (chd >= nbodies) ? (chd - \
nbodies) : ((nnodes - 1) - indexSortT[chd]);\>\"", ",", "\n", "\"\<\>\"", ",",
        "\n", "\"\<                        if ((chd >= nbodies) || \
(mass[nnodes - 1 - ch] >= 0))\>\"", ",", 
       "\n", "\"\<                            j--;\>\"", ",", 
       "\n", "\"\<                    }\>\"", ",", "\n", "\"\<\>\"", ",", 
       "\n", "\"\<                    if (j == 0)\>\"", ",", 
       "\n", "\"\<                    {\>\"", ",", 
       "\n", "\"\<                        // all children are ready\>\"", ",",
        "\n", "\"\<                        const int kch = ((nnodes - 1) - k) \
* orderAlignment; //\:043f\:043e\:0437\:0438\:0446\:0438\:044f, \:043a\:0443\
\:0434\:0430 \:0431\:0443\:0434\:0443\:0442 \:0437\:0430\:043f\:0438\:0441\
\:0430\:043d\:044b \:043c\:043c \:0434\:043b\:044f \:0442\:0435\:043a\:0443\
\:0449\:0435\:0433\:043e \:0432\:043d\:0443\:0442\:0440\:0435\:043d\:043d\
\:0435\:0433\:043e \:0443\:0437\:043b\:0430 \:0432 \:043c\:0430\:0441\:0441\
\:0438\:0432\:0435 moms\>\"", ",", 
       "\n", "\"\<                        //moms \:0445\:0440\:0430\:043d\
\:0438\:0442\:0441\:044f \:043d\:0435 \:043f\:043e \:0438\:043d\:0434\:0435\
\:043a\:0441\:0443 srt, \:0430 \:043f\:043e \:043e\:0442\:0441\:043e\:0440\
\:0442\:0438\:0440\:043e\:0432\:0430\:043d\:043d\:043e\:043c\:0443 \:043f\
\:043e\:0440\:044f\:0434\:043a\:0443 \:0443\:0437\:043b\:043e\:0432\>\"", ",",
        "\n", "\"\<\>\"", ",", 
       "\n", "\"\<    //\:0421\:0447\:0438\:0442\:0430\:0435\:043c bounding \
box \:0442\:0435\:043a\:0443\:0449\:0435\:0433\:043e \:0443\:0437\:043b\:0430 \
\:0438\:0437 \:0434\:0432\:0443\:0445 \:0434\:0435\:0442\:0435\:0439\>\"", ",",
        "\n", "\"\<                        for (i = 0; i < 2; i++)\>\"", ",", 
       "\n", "\"\<                        {\>\"", ",", 
       "\n", "\"\<                            const int chd = i * \
chdPair.second + (1 - i) * chdPair.first; // \:0438\:043d\:0434\:0435\:043a\
\:0441 i-\:0433\:043e \:0440\:0435\:0431\:0435\:043d\:043a\:0430\>\"", ",", 
       "\n", "\"\<                            if (chd >= nbodies)//\:0435\
\:0441\:043b\:0438 \:0440\:0435\:0431\:0435\:043d\:043e\:043a - \:044d\:0442\
\:043e \:043b\:0438\:0441\:0442\>\"", ",", 
       "\n", "\"\<                            {\>\"", ",", 
       "\n", "\"\<                                ch = chd - nbodies; \
//\:043d\:043e\:043c\:0435\:0440 \:0447\:0430\:0441\:0442\:0438\:0446\:044b \
\:0432 \:043e\:0442\:0441\:043e\:0440\:0442\:0438\:0440\:043e\:0432\:0430\
\:043d\:043d\:043e\:043c \:043c\:0430\:0441\:0441\:0438\:0432\:0435\>\"", ",",
        "\n", "\"\<                                const int sortedBody = \
mortonCodesIdx[ch];\>\"", ",", "\n", "\"\<\>\"", ",", 
       "\n", "\"\<                                double4 xyAB = \
gabForLeaves[sortedBody];\>\"", ",", 
       "\n", "\"\<                                lu[i] = double4{\>\"", ",", 
       "\n", "\"\<                                    ::fmin(xyAB[0], \
xyAB[2]), ::fmin(xyAB[1], xyAB[3]),\>\"", ",", 
       "\n", "\"\<                                    ::fmax(xyAB[0], \
xyAB[2]), ::fmax(xyAB[1], xyAB[3])\>\"", ",", 
       "\n", "\"\<                                };\>\"", ",", 
       "\n", "\"\<                            }\>\"", ",", 
       "\n", "\"\<                            else\>\"", ",", 
       "\n", "\"\<                            {\>\"", ",", 
       "\n", "\"\<                                ch = indexSortT[chd];\>\"", 
       ",", "\n", "\"\<                                // \:0435\:0441\:043b\
\:0438 \:0432\:043d\:0443\:0442\:0440\:0435\:043d\:043d\:0438\:0439 \:0443\
\:0437\:0435\:043b, \:0435\:0433\:043e bounding box \:0443\:0436\:0435 \:0434\
\:043e\:043b\:0436\:0435\:043d \:0431\:044b\:0442\:044c \:043f\:043e\:0441\
\:0447\:0438\:0442\:0430\:043d, \:0442\:043a \:0438\:0434\:0435\:043c \:0441\
\:043d\:0438\:0437\:0443 \:0432\:0432\:0435\:0440\:0445\>\"", ",", 
       "\n", "\"\<                                lu[i] = \
lowerupper[chd];\>\"", ",", "\n", "\"\<                            }\>\"", ",",
        "\n", "\"\<                        }//for i\>\"", ",", 
       "\n", "\"\<\>\"", ",", 
       "\n", "\"\<                        // \:041e\:0431\:044a\:0435\:0434\
\:0438\:043d\:044f\:0435\:043c bounding box \:0434\:0432\:0443\:0445 \:0434\
\:0435\:0442\:0435\:0439:\>\"", ",", 
       "\n", "\"\<                        lowerupper[srt] = double4{\>\"", ",",
        "\n", "\"\<                            ::fmin(lu[0][0], lu[1][0]), \
::fmin(lu[0][1], lu[1][1]),\>\"", ",", 
       "\n", "\"\<                            ::fmax(lu[0][2], lu[1][2]), \
::fmax(lu[0][3], lu[1][3])\>\"", ",", 
       "\n", "\"\<                        };\>\"", ",", 
